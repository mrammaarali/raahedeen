rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'admin'; }

    // Public readable assets (product images, chapter covers) under /public/
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Protected uploads (e.g., raw audio before publish) under /protected/
    match /protected/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
