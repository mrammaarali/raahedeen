rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========
    //  Helper Functions
    // ===========
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ===========
    //  Admin & User Data
    // ===========
    match /users/{uid} {
      // Admins can read/write any user doc.
      // Users can only read/update their own doc.
      allow read, write: if isAdmin();
      allow read, update: if isOwner(uid);
    }

    match /user_settings/{uid} {
      // Users can manage their own settings. Admins can too.
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ===========
    //  Public & Admin-Managed Content
    // ===========
    match /app_settings/{docId} {
      // Everyone can read settings. Only admins can write.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audiobookChapters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      match /faqs/{faqId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /duas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /finderRules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===========
    //  User-Generated Content
    // ===========
    match /gemstoneRequests/{docId} {
      // Users can create requests for themselves.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Admins can read all requests. Users can only read their own.
      allow read: if isAdmin() || isOwner(resource.data.uid);
      // Only admins can update status, etc.
      allow update: if isAdmin();
      // Users should not be able to delete their requests.
      allow delete: if isAdmin();
    }

    match /playback_progress/{docId} {
        allow read, write: if isOwner(request.resource.data.uid);
    }

    match /tasbeeh_history/{docId} {
        allow read, write: if isOwner(request.resource.data.uid);
    }
  }
}
