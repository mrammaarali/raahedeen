rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for admin role
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Users can read their own data, admins can read all user data
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if isAdmin(); // Only admins can change roles
    }

    // Allow any authenticated user to read content
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      match /faqs/{faqId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    match /audiobook_chapters/{chapterId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    match /duas/{duaId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    // Finder rules and requests can be read by any user, but only written by admins
    match /gemstone_finder_rules/{ruleId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }

    match /gemstone_finder_requests/{requestId} {
        allow read, write: if request.auth != null; // Users need to create these
    }

    // Settings can be read by any user, but only written by admins
    match /settings/app_settings {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
  }
}
